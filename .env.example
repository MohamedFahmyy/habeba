# Romantic Memories Platform - Environment Configuration Example
# Copy this file to .env or configure environment variables in your hosting environment

# Database configuration: 'sqlite' or 'mysql'
# Default is 'sqlite' which requires zero configuration and works out of the box.
DB_DRIVER=sqlite

# If DB_DRIVER=mysql, set MySQL connection details below:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=romantic_platform
DB_USER=root
DB_PASS=

# Application Security
APP_SECRET=change_this_to_a_random_long_secret_in_production
ADMIN_PASSWORD=romantic2026
